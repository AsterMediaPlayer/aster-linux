<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Views.GuideView"
             x:DataType="vm:GuideViewModel"
             c:KeyFocus.StartsFresh="True">

    <UserControl.Styles>
        <!-- Flat cells, lighter while airing, white under the pointer or the keyboard as on the Apple TV
             (no focus rectangle: it was drawn over everything, and stayed over a channel once it played). -->
        <Style Selector="Button.cell">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Background" Value="#292929" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cell.airing">
            <Setter Property="Background" Value="#383838" />
        </Style>
        <Style Selector="Button.cell:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="Button.cell:pointerover TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.cell:focus-visible /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="Button.cell:focus-visible TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="TextBlock.cellTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.cellDetail">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.day">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.day:focus-visible /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.step">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.step:focus-visible /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <!-- The group picked is tinted with the accent, as the Apple TV's filter is, so the
             keyboard's white pill (focus) always stands apart from it. -->
        <Style Selector="Button.group.selected">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.group.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.group:focus-visible /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel Margin="107,8,107,0" IsVisible="{Binding MessageTitle, Converter={x:Static ObjectConverters.IsNull}}">
            <!-- What's highlighted (or on now on the first row): its picture, then its title, episode and overview. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="5*,7*" Height="150" Margin="0,4,0,16">
                <Border CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <c:RemoteImage Url="{Binding PanelImage}" Stretch="Uniform" MaxHeight="150" MaxWidth="267" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{Binding PanelTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PanelEpisode}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding PanelEpisode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding PanelOverview}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" MaxLines="4"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- The day (with Now, Earlier and Later beside it), then the half hours across the window. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="220,*" Height="40" Margin="0,0,0,8">
                <TextBlock Text="{Binding DayLabel}" FontSize="20" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"
                           IsVisible="{Binding !HasDays}" />
                <!-- A week's guide: the day picks the day, at the time it is now. -->
                <Button Classes="day" IsVisible="{Binding HasDays}" AutomationProperties.Name="Day">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DayLabel}" FontSize="20" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding Days}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:GuideDay">
                                    <Setter Property="Header" Value="{Binding Title}" />
                                    <Setter Property="Command" Value="{Binding Select}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- The wheel with Shift (or a sideways swipe) moves through time too. -->
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Button Theme="{StaticResource PillButton}" Command="{Binding NowCommand}" IsVisible="{Binding CanJumpToNow}"
                            MinHeight="30" Padding="12,3" AutomationProperties.Name="Now" Content="Now" FontSize="13" />
                    <Button Classes="step" Content="&#xE76B;" Command="{Binding EarlierCommand}" ToolTip.Tip="An hour earlier (Shift+wheel)"
                            AutomationProperties.Name="Earlier" />
                    <Button Classes="step" Content="&#xE76C;" Command="{Binding LaterCommand}" ToolTip.Tip="An hour later (Shift+wheel)"
                            AutomationProperties.Name="Later" />
                </StackPanel>
                <Panel Grid.Column="1" x:Name="Timeline" Margin="12,0,0,0" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Ticks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuideTick">
                                <TextBlock Text="{Binding Text}" Margin="{Binding Margin}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle Fill="#E53935" Width="3" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="{Binding NowMargin}" IsVisible="{Binding ShowsNow}" />
                </Panel>
            </Grid>

            <!-- When channels have groups: All, then each group, as a cable guide's. -->
            <ItemsControl x:Name="GroupList" DockPanel.Dock="Top" ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                        <Button Theme="{StaticResource PillButton}" Classes="group" Classes.selected="{Binding IsSelected}" Command="{Binding Select}"
                                Content="{Binding Title}" MinHeight="30" Padding="14,3" FontSize="13" Margin="0,0,8,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}" Margin="0,4,0,60">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuideRowViewModel">
                            <Grid ColumnDefinitions="220,*" Height="76" Margin="0,0,0,10">
                                <!-- The channel: its number and logo (or name); Watch, or favourite it from its menu. -->
                                <Button Classes="cell" Width="220" Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding AccessibleName}"
                                        ToolTip.Tip="{Binding Name}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Watch" Command="{Binding PlayCommand}" />
                                            <MenuItem Header="{Binding FavoriteLabel}" Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding CanFavorite}" />
                                            <MenuItem Header="Group…" Command="{Binding ChooseGroupCommand}" IsVisible="{Binding CanGroup}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <DockPanel Margin="14,10">
                                        <!-- A group's name on its first channel, in the All view: inside the cell, so the rows keep their even spacing. -->
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding GroupCaption, Converter={x:Static c:Converters.Upper}}"
                                                   IsVisible="{Binding GroupCaption, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColor}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,-4,0,2" />
                                        <Grid ColumnDefinitions="44,*">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Secondary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Panel Grid.Column="1">
                                                <TextBlock Classes="cellTitle" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                                           IsVisible="{Binding !#RowLogo.HasImage}" />
                                                <c:RemoteImage x:Name="RowLogo" Url="{Binding Logo}" Stretch="Uniform" HorizontalAlignment="Left" />
                                            </Panel>
                                        </Grid>
                                    </DockPanel>
                                </Button>
                                <Panel Grid.Column="1" Margin="12,0,0,0" ClipToBounds="True">
                                    <Border Background="#1F1F1F" CornerRadius="8" IsVisible="{Binding IsLoading}">
                                        <ProgressBar IsIndeterminate="True" Width="80" HorizontalAlignment="Left" Margin="16,0" />
                                    </Border>
                                    <Button Classes="cell" Command="{Binding PlayCommand}" HorizontalAlignment="Stretch"
                                            IsVisible="{Binding Placeholder, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="cellDetail" Text="{Binding Placeholder}" Margin="16,0" VerticalAlignment="Center" />
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Panel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GuideCell">
                                                <Button Classes="cell" Classes.airing="{Binding IsAiring}" c:KeyFocus.IsPreferred="{Binding IsStart}" Width="{Binding Width}" Margin="{Binding Margin}"
                                                        Command="{Binding Open}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding Title}">
                                                    <Panel>
                                                        <Border Background="#1FFFFFFF" Width="{Binding AiredWidth}" HorizontalAlignment="Left" />
                                                        <StackPanel Margin="{Binding Inset}" Spacing="3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse Width="8" Height="8" Fill="#E53935" VerticalAlignment="Center" IsVisible="{Binding IsRecording}" />
                                                                <TextBlock Classes="cellTitle" Text="{Binding Title}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="cellDetail" Text="{Binding Subtitle}" />
                                                        </StackPanel>
                                                    </Panel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Panel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <ProgressBar IsIndeterminate="True" Width="200" VerticalAlignment="Top" Margin="0,80" IsVisible="{Binding IsLoading}" />
        <StackPanel Spacing="10" Margin="107,100" HorizontalAlignment="Center" VerticalAlignment="Top"
                    IsVisible="{Binding MessageTitle, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding MessageTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding MessageDetail}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" />
        </StackPanel>
    </Panel>
</UserControl>
