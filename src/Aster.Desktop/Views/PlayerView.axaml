<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True"
             Background="Black">

    <UserControl.Styles>
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="Button.bar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.pill.secondary">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.pill.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <ControlTheme x:Key="ChoiceItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TrackChoice">
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="Command" Value="{Binding Select}" />
            <Setter Property="ToggleType" Value="Radio" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
        </ControlTheme>
    </UserControl.Resources>

    <Grid x:Name="Surface" Background="Transparent">
        <c:MpvVideoView Player="{Binding Player}" />

        <!-- Until the first frame: the title, and that it's on its way. -->
        <StackPanel IsVisible="{Binding !HasStarted}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="200" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNull}}" />
        </StackPanel>

        <Border IsVisible="{Binding IsBuffering}" Background="#A0000000" CornerRadius="10" Padding="20,14"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="10">
                <TextBlock Text="Loading…" Foreground="White" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="140" />
            </StackPanel>
        </Border>

        <!-- The controls, shown on mouse movement and while paused. -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ControlsVisible}">
            <Border Grid.Row="0" Padding="16,12,24,40">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#B0000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button Classes="bar" DockPanel.Dock="Left" Command="{Binding CloseCommand}" ToolTip.Tip="Back (Esc)">
                        <TextBlock Classes="icon" Text="&#xE72B;" />
                    </Button>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="#CCFFFFFF" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Padding="24,48,24,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#C0000000" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}" Foreground="White" VerticalAlignment="Center" MinWidth="56" />
                        <Slider Grid.Column="1" x:Name="SeekBar" Minimum="0" Maximum="{Binding Duration}"
                                Value="{Binding SeekBarValue}" Margin="8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="White" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
                    </Grid>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
                            <Button Classes="bar" Command="{Binding TogglePauseCommand}" ToolTip.Tip="Play/Pause (Space)">
                                <Panel>
                                    <TextBlock Classes="icon" Text="&#xE768;" IsVisible="{Binding IsPaused}" />
                                    <TextBlock Classes="icon" Text="&#xE769;" IsVisible="{Binding !IsPaused}" />
                                </Panel>
                            </Button>
                            <Button Classes="bar" Command="{Binding Back10Command}" Content="−10" ToolTip.Tip="Back 10 seconds (←)" />
                            <Button Classes="bar" Command="{Binding Forward10Command}" Content="+10" ToolTip.Tip="Forward 10 seconds (→)" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button Classes="bar" ToolTip.Tip="Audio">
                                <TextBlock Classes="icon" Text="&#xE8D6;" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding AudioChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" ToolTip.Tip="Subtitles">
                                <TextBlock Classes="icon" Text="&#xE7F0;" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding SubtitleChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" Content="Speed">
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding SpeedChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" Content="Quality">
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding QualityChoices}" ItemContainerTheme="{StaticResource ChoiceItem}" />
                                </Button.Flyout>
                            </Button>
                            <Button Classes="bar" x:Name="FullScreenButton" ToolTip.Tip="Full screen (F)">
                                <TextBlock Classes="icon" Text="&#xE740;" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#C0000000" CornerRadius="8"
                Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0">
            <TextBlock Text="{Binding Toast}" Foreground="White" FontSize="16" />
        </Border>

        <!-- Skip Intro / Skip Credits / Play Next Episode. -->
        <Button Classes="pill" Content="{Binding SkipTitle}" Command="{Binding SkipCommand}"
                IsVisible="{Binding SkipVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,140" />

        <!-- Playback keeps stalling. -->
        <Border IsVisible="{Binding QualityOfferVisible}" Background="#E0202020" CornerRadius="12" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0" MaxWidth="460">
            <StackPanel Spacing="12">
                <TextBlock Text="Playback keeps pausing to load." FontSize="16" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="A lower quality may play smoothly on this connection." TextWrapping="Wrap" Foreground="#CCFFFFFF" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Lower Quality" Command="{Binding LowerQualityCommand}" />
                    <Button Content="Keep Trying" Command="{Binding KeepTryingCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Up Next, after an episode ends. -->
        <Border IsVisible="{Binding EndCardVisible}" Background="#E0181818" CornerRadius="12" Padding="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,48" MinWidth="380">
            <StackPanel Spacing="10">
                <TextBlock Text="Up Next" FontSize="14" Foreground="#AAFFFFFF" />
                <TextBlock Text="{Binding UpNextTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxWidth="420" />
                <TextBlock Text="{Binding CountdownText}" Foreground="#CCFFFFFF" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button Classes="pill" Content="Play Now" Command="{Binding PlayUpNextNowCommand}" />
                    <Button Classes="pill secondary" Content="Close" Command="{Binding DismissEndCardCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Can't play. -->
        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#F0202020"
                CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <StackPanel Spacing="12">
                <TextBlock Text="Can't Play" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#CCFFFFFF" />
                <Button Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
