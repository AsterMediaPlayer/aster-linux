<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Views.SeerrSettingsView"
             x:DataType="vm:SeerrSettingsViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://Aster.Desktop/Views/SettingsStyles.axaml" />
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Styles>

    <!-- Settings › Requests: who's signed in to Seerr, or Seerr's address and the ways it lets people sign in. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,76,48,60" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="Requests" />

            <!-- Signed in. -->
            <StackPanel Spacing="12" IsVisible="{Binding IsSignedIn}">
                <TextBlock Classes="section" Text="SEERR" />
                <Border Classes="fact">
                    <TextBlock Text="{Binding SignedInLine}" />
                </Border>
                <Button Classes="row" Command="{Binding SignOutCommand}">
                    <DockPanel>
                        <TextBlock Classes="icon" Text="&#xF3B1;" />
                        <TextBlock Text="{Binding SignOutLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <Border Classes="note">
                    <TextBlock Text="Discover shows Seerr's films and shows to request, and your requests. The sign-in follows you to Aster on your other devices." />
                </Border>
            </StackPanel>

            <!-- Signing in. -->
            <StackPanel Spacing="12" IsVisible="{Binding ShowsSignIn}">
                <Border Classes="note" IsVisible="{Binding NeedsSignIn}">
                    <TextBlock Text="Seerr ended the session. Sign in again." />
                </Border>
                <TextBlock Classes="section" Text="SEERR'S ADDRESS" />
                <TextBox Text="{Binding Address}" PlaceholderText="192.168.1.240:5055 or https://requests.example.com" c:KeyFocus.IsPreferred="True" />
                <Button Classes="row" Command="{Binding FindCommand}" IsEnabled="{Binding !IsBusy}">
                    <DockPanel>
                        <TextBlock Classes="chevron" />
                        <TextBlock Text="Continue" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <StackPanel Spacing="12" IsVisible="{Binding Found}">
                    <!-- Quick Connect: nothing to type, approved through this Jellyfin when it's Seerr's. -->
                    <StackPanel Spacing="12" IsVisible="{Binding OffersQuickConnect}">
                        <TextBlock Classes="section" Text="QUICK CONNECT" />
                        <Button Classes="row" Command="{Binding SignInWithQuickConnectCommand}">
                            <DockPanel>
                                <TextBlock Classes="chevron" />
                                <TextBlock Text="Sign In with Quick Connect" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <Border Classes="fact" IsVisible="{Binding HasCode}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Approve this code in Jellyfin (Settings › Quick Connect):" />
                                <TextBlock Text="{Binding Code}" FontSize="40" FontWeight="Bold" LetterSpacing="6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- The media server's user and password. -->
                    <StackPanel Spacing="12" IsVisible="{Binding OffersMediaServer}">
                        <TextBlock Classes="section" Text="{Binding MediaServerName, StringFormat='{}{0} USER'}" />
                        <TextBox Text="{Binding UserName}" PlaceholderText="User name" />
                        <TextBox Text="{Binding Password}" PlaceholderText="Password" PasswordChar="•" />
                        <Button Classes="row" Command="{Binding SignInWithPasswordCommand}" IsEnabled="{Binding !IsBusy}">
                            <DockPanel>
                                <TextBlock Classes="chevron" />
                                <TextBlock Text="Sign In" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- A Seerr account of its own. -->
                    <StackPanel Spacing="12" IsVisible="{Binding OffersLocal}">
                        <TextBlock Classes="section" Text="SEERR ACCOUNT" />
                        <TextBox Text="{Binding Email}" PlaceholderText="Email address" />
                        <TextBox Text="{Binding LocalPassword}" PlaceholderText="Password" PasswordChar="•" />
                        <Button Classes="row" Command="{Binding SignInLocalCommand}" IsEnabled="{Binding !IsBusy}">
                            <DockPanel>
                                <TextBlock Classes="chevron" />
                                <TextBlock Text="Sign In with a Seerr Account" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Classes="note">
                    <TextBlock Text="Seerr (Overseerr and Jellyseerr) takes requests for films and shows the server hasn't got. Signed in, Discover shows them to request. A sign-in made on Aster on your phone or another computer comes here by itself." />
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                       IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
