<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://Aster.Desktop/Views/SettingsStyles.axaml" />
    </UserControl.Styles>

    <!-- Settings' pages under their headings, as the Apple app lists them: each opens over the list. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="107,76,107,60">
            <TextBlock Classes="pageTitle" Text="Settings" />

            <TextBlock Classes="section" Text="PLAYBACK" />
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.Streaming}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xEC05;" />
                    <TextBlock Text="Streaming &amp; Data" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.Video}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE768;" />
                    <TextBlock Text="Video" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.Music}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE8D6;" />
                    <TextBlock Text="Music" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <TextBlock Classes="section" Text="LIBRARY" />
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.Anime}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE734;" />
                    <TextBlock Text="Anime" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.TitlePages}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE7F4;" />
                    <TextBlock Text="Title Pages" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenChannelsCommand}" IsVisible="{Binding OffersChannels}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE714;" />
                    <TextBlock Text="Channels" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <TextBlock Classes="section" Text="THIS DEVICE" />
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.General}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE713;" />
                    <TextBlock Text="General" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <TextBlock Classes="section" Text="SERVICES" IsVisible="{Binding IsJellyfin}" />
            <Button Classes="row" Command="{Binding OpenServerPluginsCommand}" IsVisible="{Binding IsJellyfin}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xEA86;" />
                    <TextBlock Text="Server Plugins" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.Account}" Margin="0,24,0,0">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="value" Text="{Binding UserName}" />
                    <TextBlock Classes="icon" Text="&#xE77B;" />
                    <TextBlock Text="Account" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Classes="row" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:SettingsPage.About}">
                <DockPanel>
                    <TextBlock Classes="chevron" />
                    <TextBlock Classes="icon" Text="&#xE8FD;" />
                    <TextBlock Text="About" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
