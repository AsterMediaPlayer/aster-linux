<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.SeriesTimerView"
             x:DataType="vm:SeriesTimerViewModel"
             Background="#141414">

    <!-- Laid out as Settings is: a heading over each rounded group. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,28,0,10" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,6" />
        </Style>
        <Style Selector="DockPanel.row">
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style Selector="DockPanel.row > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="DockPanel.row > ComboBox">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="DockPanel.row > ToggleSwitch">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-12,0" />
        </Style>
        <Style Selector="Rectangle.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="#1AFFFFFF" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="64,80,64,60" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ChannelName}" Foreground="{StaticResource Secondary}" Margin="0,6,0,0"
                           IsVisible="{Binding ChannelName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Left" Margin="0,40" IsVisible="{Binding !IsLoaded}" />

                <StackPanel IsVisible="{Binding IsLoaded}" IsEnabled="{Binding !IsWorking}">
                    <TextBlock Classes="heading" Text="Record" />
                    <Border Classes="group">
                        <StackPanel>
                            <DockPanel Classes="row">
                                <ToggleSwitch IsChecked="{Binding NewOnly}" AutomationProperties.Name="New episodes only" />
                                <TextBlock Text="New episodes only" />
                            </DockPanel>
                            <Rectangle Classes="divider" />
                            <DockPanel Classes="row">
                                <ToggleSwitch IsChecked="{Binding AnyChannel}" AutomationProperties.Name="On any channel" />
                                <TextBlock Text="On any channel" />
                            </DockPanel>
                            <Rectangle Classes="divider" />
                            <DockPanel Classes="row">
                                <ToggleSwitch IsChecked="{Binding AnyTime}" AutomationProperties.Name="At any time" />
                                <TextBlock Text="At any time" />
                            </DockPanel>
                            <Rectangle Classes="divider" />
                            <DockPanel Classes="row">
                                <ToggleSwitch IsChecked="{Binding SkipInLibrary}" AutomationProperties.Name="Skip episodes already in the library" />
                                <TextBlock Text="Skip episodes already in the library" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="heading" Text="Keep" />
                    <Border Classes="group">
                        <StackPanel>
                            <DockPanel Classes="row">
                                <ComboBox ItemsSource="{Binding KeepUpToOptions}" SelectedItem="{Binding KeepUpTo}" AutomationProperties.Name="Keep up to" />
                                <TextBlock Text="Keep up to" />
                            </DockPanel>
                            <Rectangle Classes="divider" />
                            <DockPanel Classes="row">
                                <ComboBox ItemsSource="{Binding KeepUntilOptions}" SelectedItem="{Binding KeepUntil}" AutomationProperties.Name="Keep recordings" />
                                <TextBlock Text="Keep recordings" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="heading" Text="Padding" />
                    <Border Classes="group">
                        <StackPanel>
                            <DockPanel Classes="row">
                                <ComboBox ItemsSource="{Binding PaddingOptions}" SelectedItem="{Binding StartEarly}" AutomationProperties.Name="Start early" />
                                <TextBlock Text="Start early" />
                            </DockPanel>
                            <Rectangle Classes="divider" />
                            <DockPanel Classes="row">
                                <ComboBox ItemsSource="{Binding PaddingOptions}" SelectedItem="{Binding EndLate}" AutomationProperties.Name="End late" />
                                <TextBlock Text="End late" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,24,0,0">
                        <Button Theme="{StaticResource PillButton}" Classes="prominent" Content="Save" Command="{Binding SaveCommand}" />
                        <!-- Asks first: the scheduled recordings go with it. -->
                        <Button Theme="{StaticResource PillButton}" Content="Cancel Series Recording">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <StackPanel Spacing="12" MaxWidth="300">
                                        <TextBlock Text="Cancel this series recording?" FontWeight="SemiBold" />
                                        <TextBlock Text="Scheduled recordings for this series will be removed. Finished recordings are kept." TextWrapping="Wrap"
                                                   Foreground="{StaticResource Secondary}" FontSize="12" />
                                        <Button Content="Cancel Series Recording" Command="{Binding CancelSeriesCommand}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,16,0,0"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </ScrollViewer>

        <Button Command="{Binding BackCommand}" ToolTip.Tip="Back (Alt+←)" AutomationProperties.Name="Back" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Width="44" Height="44" CornerRadius="22" Background="#B3000000" Foreground="White" HorizontalContentAlignment="Center">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" />
        </Button>
    </Panel>
</UserControl>
