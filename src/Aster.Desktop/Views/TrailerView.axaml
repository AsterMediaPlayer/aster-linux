<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.TrailerView"
             x:DataType="vm:TrailerViewModel"
             Background="Black">

    <!--
    A YouTube trailer, as the Apple app's sheet: YouTube's player over the
    whole page but a bar above it, with the way back and the title. On
    Linux WebKitGTK only plays in a window of its own, so the player is a
    borderless one, full screen.
    -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="20,16">
            <Button x:Name="BackButton" Theme="{StaticResource BackButton}" Command="{Binding BackCommand}" ToolTip.Tip="Back (Alt+←)"
                    AutomationProperties.Name="Back" Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF" Foreground="White"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" />
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" Foreground="White"
                       VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
        <!-- Where the player's window sits, kept over this as the window moves. -->
        <Border x:Name="Host" Background="Black" />
    </DockPanel>
</UserControl>
