<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.LiveTVView"
             x:DataType="vm:LiveTVViewModel">

    <!-- The title and sections stay put; the section beneath scrolls on its own. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="48,76,48,8">
            <TextBlock Text="Live TV" FontSize="32" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                        <Button Theme="{StaticResource PillButton}" Classes.selected="{Binding IsSelected}" Command="{Binding Select}"
                                Content="{Binding Title}" MinHeight="36" Padding="16,6" AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ContentControl Content="{Binding CurrentSection}" />
    </DockPanel>
</UserControl>
