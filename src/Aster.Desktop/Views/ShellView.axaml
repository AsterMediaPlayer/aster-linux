<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             x:Class="Aster.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="200,*">
        <!-- The sidebar. -->
        <Border Grid.Column="0" Background="#141414" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0" Padding="12,20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Aster" FontSize="24" FontWeight="Bold" Margin="14,0,0,24" />
                <StackPanel DockPanel.Dock="Bottom" Spacing="4">
                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" Margin="14,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ServerName}" FontSize="12" Foreground="{StaticResource Secondary}" Margin="14,0,14,8" TextTrimming="CharacterEllipsis" />
                    <!-- Asks first: a stray click or Enter shouldn't sign anyone out. -->
                    <Button Classes="nav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xF3B1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Sign Out" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedBottom">
                                <StackPanel Spacing="12" MaxWidth="260">
                                    <TextBlock Text="{Binding ServerName, StringFormat='Sign out of {0}?'}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <Button Content="Sign Out" Command="{Binding SignOutCommand}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarTab">
                            <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding Select}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- The page. -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</UserControl>
