<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="107,76,107,8">
            <TextBlock Text="Search" FontSize="32" FontWeight="Bold" />
            <!-- As wide as there's room for, up to 720, from the left. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="720" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Box" c:KeyFocus.IsPreferred="True" Text="{Binding Query}" PlaceholderText="Movies, shows, episodes, music"
                         FontSize="16" Padding="44,11,12,11" CornerRadius="10" AutomationProperties.Name="Search your library" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Secondary}"
                           Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <!-- From the couch, with a controller: the letters on the screen. -->
            <c:OnScreenKeyboard x:Name="Keys" Text="{Binding Query}" IsVisible="False" />
        </StackPanel>

        <ScrollViewer x:Name="Results" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="0,8,0,60">
                <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Left" Margin="107,0" IsVisible="{Binding IsSearching}" />

                <StackPanel Spacing="10" Margin="107,100" HorizontalAlignment="Center" IsVisible="{Binding HasMessage}">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="44" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding MessageTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding MessageDetail}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding HasShows}">
                    <TextBlock Text="Movies &amp; TV Shows" FontSize="20" FontWeight="SemiBold" Margin="{StaticResource ScreenPadding}" />
                    <ItemsControl ItemsSource="{Binding Shows}" ItemTemplate="{StaticResource PosterCard}" Margin="{StaticResource ScreenPadding}" Padding="0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="20" LineSpacing="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <c:ShelfView Title="Episodes" Items="{Binding Episodes}" ItemTemplate="{StaticResource LandscapeCard}" />
                <c:ShelfView Title="Albums &amp; Playlists" Items="{Binding Albums}" ItemTemplate="{StaticResource SquareCard}" />
                <c:ShelfView Title="Artists" Items="{Binding Artists}" ItemTemplate="{StaticResource RoundCard}" />
                <c:ShelfView Title="Songs" Items="{Binding Songs}" ItemTemplate="{StaticResource SquareCard}" />
                <!-- With Seerr: what it has for the search that the library hasn't, to request. -->
                <c:ShelfView Title="Request" Items="{Binding Requestable}" ItemTemplate="{StaticResource SeerrCard}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
