<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aster.Desktop.App"
             xmlns:local="using:Aster.Desktop"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Views/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Scroll areas follow the keyboard; they never take it themselves. -->
        <Style Selector="ScrollViewer">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- A song or chapter row: a faint panel, a little brighter for the one playing. -->
        <Style Selector="Button.track">
            <Setter Property="Background" Value="#0FFFFFFF" />
        </Style>
        <Style Selector="Button.track.current">
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
        <!-- Every slider (a timeline, a chapter's bar, a room's volume): no focus rectangle, which is drawn
             over everything; the controller's mark is the handle, white and grown, as the Apple TV's. -->
        <Style Selector="Slider">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider:focus-visible /template/ Thumb">
            <Setter Property="Background" Value="White" />
            <Setter Property="RenderTransform" Value="scale(1.35)" />
        </Style>
    </Application.Styles>
</Application>