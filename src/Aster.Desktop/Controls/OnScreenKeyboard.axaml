<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aster.Desktop.Controls.OnScreenKeyboard">
    <UserControl.Styles>
        <!-- Keys as the pills are: grey, and white with black for the one the controller is on. -->
        <Style Selector="Button.key">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.key.wide">
            <Setter Property="Width" Value="146" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Styles>
    <StackPanel x:Name="Rows" Spacing="8" />
</UserControl>
