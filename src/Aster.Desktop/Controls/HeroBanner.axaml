<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Desktop.ViewModels"
             xmlns:c="using:Aster.Desktop.Controls"
             x:Class="Aster.Desktop.Controls.HeroBanner"
             x:DataType="vm:HeroModel"
             IsVisible="{Binding HasPages}">

    <UserControl.Styles>
        <!-- For the pointer: the keyboard and remote page with left and right on the banner's Play. -->
        <Style Selector="Button.heroArrow">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <!-- The whole banner opens the title with the pointer (no button chrome); the keyboard stops on Play. -->
        <Style Selector="Button.heroPage">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.heroPage:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.heroPage:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <c:HeroCarousel x:Name="Pages" ItemsSource="{Binding Pages}" SelectedIndex="{Binding Index}">
            <c:HeroCarousel.PageTransition>
                <PageSlide Duration="0:0:0.35" Orientation="Horizontal" />
            </c:HeroCarousel.PageTransition>
            <c:HeroCarousel.ItemTemplate>
                <DataTemplate x:DataType="vm:HeroPage">
                    <Button Classes="heroPage" Command="{Binding OpenCommand}">
                        <Panel>
                            <Border Background="#141414" />
                            <c:RemoteImage Url="{Binding Backdrop}" />
                            <c:RemoteImage Url="{Binding Cover}" IsVisible="{Binding HasCover}">
                                <c:RemoteImage.Effect>
                                    <BlurEffect Radius="60" />
                                </c:RemoteImage.Effect>
                            </c:RemoteImage>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="50%,45%" EndPoint="50%,100%">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="0.4" Color="#33000000" />
                                        <GradientStop Offset="1" Color="#E6000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="50%,50%">
                                        <GradientStop Offset="0" Color="#99000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Bottom" Margin="107,0,107,72">
                                <Border Width="200" Height="200" CornerRadius="14" ClipToBounds="True" Background="#262626" BoxShadow="0 12 30 0 #80000000"
                                        Margin="0,0,40,0" VerticalAlignment="Bottom" IsVisible="{Binding HasCover}">
                                    <c:RemoteImage Url="{Binding Cover}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="760">
                                    <!-- White with black text, readable over any backdrop. -->
                                    <Border Background="White" CornerRadius="14" Padding="14,5" HorizontalAlignment="Left"
                                            IsVisible="{Binding Tag, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="{Binding Tag}" Foreground="Black" FontWeight="Bold" LetterSpacing="1.5" />
                                    </Border>
                                    <Panel HorizontalAlignment="Left">
                                        <c:RemoteImage x:Name="Logo" Url="{Binding Logo}" Stretch="Uniform" MaxWidth="360" MaxHeight="130" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Title}" FontSize="44" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2"
                                                   IsVisible="{Binding !#Logo.HasImage}" />
                                    </Panel>
                                    <TextBlock Text="{Binding EpisodeLine}" FontSize="20" FontWeight="SemiBold"
                                               IsVisible="{Binding EpisodeLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource MetadataTemplate}" />
                                    <TextBlock Text="{Binding Overview}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" MaxLines="3"
                                               TextTrimming="CharacterEllipsis" MaxWidth="640" HorizontalAlignment="Left" />
                                    <Button Theme="{StaticResource PillButton}" Classes="prominent" c:KeyFocus.IsPreferred="True" Command="{Binding PlayCommand}"
                                            HorizontalAlignment="Left" Padding="26,12">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding PlayGlyph}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PlayLabel}" />
                                            <TextBlock Text="{Binding Remaining}" Opacity="0.6"
                                                       IsVisible="{Binding Remaining, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Button>
                </DataTemplate>
            </c:HeroCarousel.ItemTemplate>
        </c:HeroCarousel>

        <Button Classes="heroArrow" HorizontalAlignment="Left" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous" IsVisible="{Binding HasPrevious}">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" />
        </Button>
        <Button Classes="heroArrow" HorizontalAlignment="Right" Command="{Binding NextCommand}" ToolTip.Tip="Next" IsVisible="{Binding HasNext}">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" />
        </Button>

        <Border Background="#59000000" CornerRadius="12" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,64,40"
                IsVisible="{Binding HasNext}">
            <ItemsControl ItemsSource="{Binding Dots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:Boolean">
                        <Ellipse Width="9" Height="9" Fill="White" Opacity="{Binding Converter={x:Static c:Converters.DotOpacity}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Panel>
</UserControl>
